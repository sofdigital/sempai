<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- To consume packages from GitHub Packages, replace OWNER below with your GitHub org/user.
       Authentication can be provided via `GITHUB_TOKEN` (CI) or a classic PAT with `read:packages` scope (local).
       Example to add creds locally:
         dotnet nuget add source "https://nuget.pkg.github.com/sofdigital/index.json" \
           --name github --username YOUR_GH_USERNAME --password YOUR_PAT --store-password-in-clear-text
  -->
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="github" value="https://nuget.pkg.github.com/sofdigital/index.json" />
  </packageSources>
  <activePackageSource>
    <add key="All" value="(Aggregate source)" />
  </activePackageSource>
</configuration>
