<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>

        <RootNamespace>SofDigital.Sempai.Core</RootNamespace>
        <AssemblyName>SofDigital.Sempai.Core</AssemblyName>

        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <!-- NuGet package metadata -->
        <IsPackable>true</IsPackable>
        <PackageId>Sempai.Core</PackageId>
        <Version>0.1.0</Version>
        <Authors>SofDigital</Authors>
        <Company>SofDigital</Company>
        <Description>Core primitives and abstractions for the Sempai ecosystem.</Description>
        <PackageTags>sempai;core;infrastructure</PackageTags>

        <!-- Repo/links -->
        <RepositoryType>git</RepositoryType>
        <RepositoryUrl>https://github.com/sofdigital/sempai</RepositoryUrl>
        <PackageProjectUrl>https://github.com/sofdigital/sempai</PackageProjectUrl>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>

        <!-- Licensing/Docs inside package -->
        <PackageLicenseFile>LICENSE</PackageLicenseFile>
        <!-- You can switch to README.md later if present -->
        <!--<PackageReadmeFile>README.md</PackageReadmeFile>-->

        <!-- Symbols & Source Link -->
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <Deterministic>true</Deterministic>
        <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>

    <ItemGroup>
        <!-- Ensure license and support files are included in the package -->
        <None Include="../../LICENSE" Pack="true" PackagePath="/"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Agents.AI" Version="1.0.0-preview.251007.1"/>
        <PackageReference Include="Microsoft.Agents.AI.Workflows" Version="1.0.0-preview.251007.1"/>
        <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All"/>
    </ItemGroup>

</Project>
