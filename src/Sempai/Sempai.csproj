<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>

        <RootNamespace>SofDigital.Sempai</RootNamespace>
        <AssemblyName>SofDigital.Sempai</AssemblyName>

        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <!-- NuGet package metadata -->
        <IsPackable>true</IsPackable>
        <PackageId>Sempai</PackageId>
        <Version>0.1.0</Version>
        <Authors>SofDigital</Authors>
        <Company>SofDigital</Company>
        <Description>Main Sempai library aggregating core features.</Description>
        <PackageTags>sempai;framework</PackageTags>

        <!-- Repo/links -->
        <RepositoryType>git</RepositoryType>
        <RepositoryUrl>https://github.com/sofdigital/sempai</RepositoryUrl>
        <PackageProjectUrl>https://github.com/sofdigital/sempai</PackageProjectUrl>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>

        <!-- Licensing/Docs inside package -->
        <PackageLicenseFile>LICENSE</PackageLicenseFile>
        <!--<PackageReadmeFile>README.md</PackageReadmeFile>-->

        <!-- Symbols & Source Link -->
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <Deterministic>true</Deterministic>
        <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>

    <ItemGroup>
        <None Include="../../LICENSE" Pack="true" PackagePath="/"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.1"/>
        <PackageReference Include="Anthropic.SDK" Version="5.8.0"/>
        <PackageReference Include="Azure.AI.Agents.Persistent" Version="1.2.0-beta.5"/>
        <PackageReference Include="Azure.AI.OpenAI" Version="2.5.0-beta.1"/>
        <PackageReference Include="Azure.Identity" Version="1.17.1"/>
        <PackageReference Include="Google_GenerativeAI.Microsoft" Version="3.4.1"/>
        <PackageReference Include="Microsoft.Agents.AI.AzureAI" Version="1.0.0-preview.251007.1"/>
        <PackageReference Include="Microsoft.Agents.AI.OpenAI" Version="1.0.0-preview.251007.1"/>
        <PackageReference Include="Microsoft.Agents.AI.Workflows" Version="1.0.0-preview.251007.1"/>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Scripting" Version="5.0.0"/>
        <PackageReference Include="Microsoft.Extensions.AI" Version="10.1.1"/>
        <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.1"/>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.1"/>
        <PackageReference Include="OllamaSharp" Version="5.4.12"/>
        <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Sempai.Core\Sempai.Core.csproj"/>
    </ItemGroup>

</Project>
